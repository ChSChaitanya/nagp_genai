# =============================================================================
# AI Travel Planning Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================================

# --- Databricks Model Serving ---
# Databricks workspace URL
DATABRICKS_HOST=https://adb-6192355565634015.15.azuredatabricks.net

# Databricks personal access token (required)
DATABRICKS_TOKEN=your_databricks_pat_here

# Databricks serving endpoint for chat LLM
DATABRICKS_LLM_ENDPOINT=mbusa-openai-gpt-5-6-luna

# Databricks serving endpoint for embeddings
DATABRICKS_EMBEDDING_ENDPOINT=databricks-bge-large-en

# --- MCP Tool: Weather ---
# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# --- MCP Tool: Currency ---
# ExchangeRate API key (free tier: https://www.exchangerate-api.com/)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# --- Application Settings ---
# Destination city for the travel assistant
DESTINATION_CITY=Singapore

# Path to knowledge base documents
KNOWLEDGE_BASE_PATH=data/knowledge_base

# Vector store persistence directory
VECTOR_STORE_PATH=data/vector_store

# Chunk size for document splitting
CHUNK_SIZE=1000

# Chunk overlap
CHUNK_OVERLAP=200

# Number of retrieved chunks for RAG
RETRIEVER_TOP_K=5

# --- Streamlit ---
STREAMLIT_PORT=8501
